# =============================================================================
# Trajct — Environment variable template
# =============================================================================
# Copy to .env for local dev. NEVER commit .env with real values.
# In production, secrets live in Doppler (synced to Vercel/Railway env vars).
# See docs/runbooks/secrets.md for rotation procedures.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (Postgres 16 + pgvector)
# Local: matches docker-compose.yml
# Staging/Prod: Neon or Supabase connection string (pgbouncer-pooled)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://trajct:trajct_dev_password@localhost:5432/trajct_dev"
DATABASE_SHADOW_URL="postgresql://trajct:trajct_dev_password@localhost:5433/trajct_shadow"

# App DB role (least-privilege, sets GUC for RLS)
DATABASE_APP_ROLE_PASSWORD="replace_with_strong_password"

# ---------------------------------------------------------------------------
# Redis (BullMQ queues, session cache, spend-cap counters, rate-limiting)
# Cap counters use AOF (appendonly yes) — do not disable persistence.
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# AI / LLM Gateway
# Primary: OpenRouter (multi-provider, per-task routing)
# See packages/ai/src/adapters/ for supported providers.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY="sk-or-v1-replace-with-real-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Optional direct-provider keys (used as fallback, must pass eval gate first)
ANTHROPIC_API_KEY="sk-ant-replace-with-real-key"
OPENAI_API_KEY="sk-replace-with-real-key"

# ---------------------------------------------------------------------------
# Spend cap defaults (in USD cents — prevent typos with explicit units)
# F-077: These are defaults; ops can adjust per-account via admin console (F-079).
# Q-077.1 / Q-077.2: exact values are open questions — these are safe conservative defaults.
# ---------------------------------------------------------------------------
CAP_FREE_TIER_MONTHLY_CENTS="500"
CAP_PAID_TIER_MONTHLY_CENTS="5000"
CAP_GLOBAL_MONTHLY_CENTS="100000"
CAP_WARN_THRESHOLD_PCT="80"
CAP_CRITICAL_THRESHOLD_PCT="95"

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# BETTER_AUTH_SECRET must be ≥32 chars, random, never reused across envs.
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace_with_32plus_char_random_secret_never_reuse"
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payments (Stripe)
# Use test keys (sk_test_...) for local dev and staging.
# NEVER use live keys outside production.
# Q-073.1: PSP choice + regional acquirers for MENA/APAC — Stripe is primary.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_replace_with_real_test_key"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_real_test_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_webhook_signing_secret"

# ---------------------------------------------------------------------------
# File storage (Cloudflare R2 — S3-compatible)
# Zero egress fees for resume downloads, exports.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID="replace_with_cloudflare_account_id"
R2_ACCESS_KEY_ID="replace_with_r2_access_key"
R2_SECRET_ACCESS_KEY="replace_with_r2_secret_key"
R2_BUCKET_RESUMES="trajct-resumes-dev"
R2_BUCKET_EXPORTS="trajct-exports-dev"
R2_BUCKET_ASSETS="trajct-assets-dev"
R2_PUBLIC_URL="https://replace.r2.cloudflarestorage.com"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_replace_with_real_key"
RESEND_FROM_EMAIL="noreply@trajct.com"

# ---------------------------------------------------------------------------
# Feature flags
# SCREENING_ENABLED: defaults to false everywhere; set per-region in feature_flags table.
# Never set to true without completing the screening launch gate (see packages/core/screening/README.md).
# ---------------------------------------------------------------------------
SCREENING_ENABLED="false"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN="https://replace@sentry.io/replace"
LANGFUSE_PUBLIC_KEY="pk-lf-replace"
LANGFUSE_SECRET_KEY="sk-lf-replace"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="3001"
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Doppler (production secret management)
# In staging/prod, all vars above come from Doppler — this file is the template.
# See: https://docs.doppler.com/docs/enclave-installation
# ---------------------------------------------------------------------------
# DOPPLER_TOKEN=dp.st.replace_with_service_token  # set in CI, not here
